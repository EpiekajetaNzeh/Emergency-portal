NODE_ENV=development
PORT=5001

# Database (PostgreSQL example)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=buildifyhub_dev

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=30d

# Optional: For Sequelize CLI if not using .sequelizerc for environment specific config
# DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/buildifyhub_dev
